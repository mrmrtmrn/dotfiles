{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(volta pin:*)",
      "Bash(mkdir:*)",
      "Bash(test:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:www.cho-kaguyahime.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/security-check.sh"
          }
        ]
      }
    ]
  }
}
